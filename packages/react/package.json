{
  "name": "creance",
  "version": "0.2.0",
  "description": "React components for human-in-the-loop agent interfaces: approvals, tool calls, run timelines, diff review and handoffs.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./simulator": {
      "types": "./dist/simulator/index.d.ts",
      "default": "./dist/simulator.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "codemods/*.mjs"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "size": "size-limit"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-tooltip": "^1.3.0"
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "^14.2.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "size-limit": "^14.2.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "keywords": [
    "react",
    "agents",
    "ai",
    "human-in-the-loop",
    "approval",
    "design-system",
    "accessibility"
  ],
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "creance-codemod-on-allow": "./codemods/on-approve-to-on-allow.mjs"
  }
}
