{
  "name": "@creance-ui/react",
  "version": "0.5.0",
  "description": "A React component library in a frosted-glass style: 109 components in light and dark, with a set for supervising AI agents (approvals, tool calls, run timelines, diff review and handoffs).",
  "license": "MIT",
  "author": "Amit Shrivastava",
  "homepage": "https://creance.pages.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amitshrivastavaa/creance.git",
    "directory": "packages/react"
  },
  "bugs": "https://github.com/amitshrivastavaa/creance/issues",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./simulator": {
      "types": "./dist/simulator/index.d.ts",
      "default": "./dist/simulator.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "codemods/*.mjs"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "size": "size-limit"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.21",
    "@radix-ui/react-context-menu": "^2.3.8",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "@radix-ui/react-popover": "^1.2.0",
    "@radix-ui/react-slider": "^1.5.0",
    "@radix-ui/react-tabs": "^1.1.22",
    "@radix-ui/react-toast": "^1.2.24",
    "@radix-ui/react-toggle-group": "^1.1.20",
    "@radix-ui/react-tooltip": "^1.3.0"
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "^14.2.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "size-limit": "^14.2.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "keywords": [
    "react",
    "agents",
    "ai",
    "human-in-the-loop",
    "approval",
    "design-system",
    "components",
    "ui",
    "accessibility"
  ],
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "creance-codemod-on-allow": "./codemods/on-approve-to-on-allow.mjs"
  },
  "publishConfig": {
    "access": "public"
  }
}
