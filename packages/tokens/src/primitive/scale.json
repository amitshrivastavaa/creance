      },
      "mono": {
        "$value": "'SF Mono', ui-monospace, 'JetBrains Mono', Menlo, Consolas, monospace",
        "$type": "fontFamily"
      }
    },
    "size": {
      "xs": {
        "$value": "12px",
        "$type": "dimension"
      },
