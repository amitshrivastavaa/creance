    "md": {
      "$value": "12px",
      "$type": "dimension"
    },
    "lg": {
      "$value": "18px",
      "$type": "dimension"
    },
    "xl": {
      "$value": "24px",
      "$type": "dimension"
    },
    "full": {
      "$value": "9999px",
      "$type": "dimension"
    }
  },
  "font": {
    "family": {
      "display": {
        "$value": "'Instrument Serif', 'Iowan Old Style', Georgia, serif",
        "$type": "fontFamily"
      },
      "sans": {
        "$value": "'Inter Tight', 'Inter', system-ui, -apple-system, sans-serif",
        "$type": "fontFamily"
      },
      "mono": {
        "$value": "'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace",
        "$type": "fontFamily"
      }
    },
    "size": {
      "xs": {
        "$value": "12px",
        "$type": "dimension"
      },
      "sm": {
        "$value": "13px",
        "$type": "dimension"
      },
      "md": {
        "$value": "14px",
        "$type": "dimension"
      },
      "lg": {
        "$value": "16px",
        "$type": "dimension"
      },
      "xl": {
        "$value": "20px",
        "$type": "dimension"
      },
      "2xl": {
        "$value": "24px",
        "$type": "dimension"
      },
      "3xl": {
        "$value": "30px",
        "$type": "dimension"
      }
    },
    "weight": {
      "regular": {
        "$value": 400,
        "$type": "fontWeight"
      },
      "medium": {
        "$value": 500,
        "$type": "fontWeight"
      },
      "semibold": {
        "$value": 600,
        "$type": "fontWeight"
      }
    },
    "line-height": {
      "tight": {
        "$value": 1.25,
        "$type": "number"
      },
      "normal": {
        "$value": 1.5,
        "$type": "number"
      }
    },
    "tracking": {
      "tight": {
        "$value": "-0.01em"
      },
      "title": {
        "$value": "-0.022em"
      }
    }
  },
  "motion": {
    "duration": {
      "fast": {
        "$value": "120ms",
        "$type": "duration"
      },
      "base": {
        "$value": "200ms",
        "$type": "duration"
      },
      "slow": {
        "$value": "320ms",
        "$type": "duration"
      }
    },
    "easing": {
      "standard": {
        "$value": "cubic-bezier(0.2, 0, 0, 1)"
      },
      "spring": {
        "$value": "cubic-bezier(0.32, 0.72, 0, 1)"
      }
    }
  },
  "focus": {
    "width": {
      "$value": "2px",
      "$type": "dimension"
    },
    "offset": {
      "$value": "2px",
      "$type": "dimension"
    }
  },
  "glass": {
    "opacity": {
      "$value": "62%"
    },
    "filter": {
      "$value": "blur(16px) saturate(140%)"
    }
  }
}