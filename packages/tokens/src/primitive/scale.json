      "semibold": {
        "$value": 600,
        "$type": "fontWeight"
      },
      "bold": {
        "$value": "700",
        "$type": "fontWeight"
      }
    },
    "line-height": {
      "tight": {
        "$value": 1.25,
        "$type": "number"
      },
      "normal": {
        "$value": 1.5,
        "$type": "number"
      }
    },
    "tracking": {
      "tight": {
        "$value": "-0.01em"
      },
      "title": {
        "$value": "-0.022em"
      }
    }
  },
  "motion": {
    "duration": {
      "fast": {
        "$value": "120ms",
        "$type": "duration"
      },
      "base": {
        "$value": "200ms",
        "$type": "duration"
      },
      "slow": {
        "$value": "320ms",
        "$type": "duration"
      }
    },
    "easing": {
      "standard": {
        "$value": "cubic-bezier(0.2, 0, 0, 1)"
      },
      "spring": {
        "$value": "cubic-bezier(0.32, 0.72, 0, 1)"
      }
    }
  },
  "focus": {
    "width": {
      "$value": "3px",
      "$type": "dimension"
    },
    "offset": {
      "$value": "2px",
      "$type": "dimension"
    }
  },
  "glass": {
    "opacity": {
      "window": {
        "$value": "32%"
      },
      "tile": {
        "$value": "50%"
      },
      "sheet": {
        "$value": "62%"
      },
      "popover": {
        "$value": "80%"
      },
      "control": {
        "$value": "70%"
      }
    },
    "filter": {
      "window": {
        "$value": "blur(40px) saturate(170%)"
      },
      "sheet": {
        "$value": "blur(24px) saturate(180%)"
      }
    }
  },
  "control": {
    "height": {
      "md": {
        "$value": "44px",
        "$type": "dimension"
      },
      "sm": {
        "$value": "36px",
        "$type": "dimension"
      }
    }
