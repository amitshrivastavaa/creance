{
  "color": {
    "bg": {
      "canvas": {
        "$value": "{slate.50}",
        "$type": "color"
      },
      "surface": {
        "$value": "{slate.0}",
        "$type": "color"
      },
      "raised": {
        "$value": "{slate.0}",
        "$type": "color"
      },
      "subtle": {
        "$value": "rgb(17 21 28 / 0.05)",
        "$type": "color"
      },
      "inverse": {
        "$value": "{slate.900}",
        "$type": "color"
      },
      "overlay": {
        "$value": "rgb(11 14 19 / 0.25)",
        "$type": "color"
      }
    },
    "glass": {
      "surface": {
        "$value": "color-mix(in srgb, {color.bg.surface} {glass.opacity}, transparent)",
        "$type": "color"
      }
    },
    "text": {
      "default": {
        "$value": "{slate.900}",
        "$type": "color"
      },
      "muted": {
        "$value": "{slate.500}",
        "$type": "color"
      },
      "inverse": {
        "$value": "{slate.0}",
        "$type": "color"
      },
      "link": {
        "$value": "{slate.900}",
        "$type": "color"
      }
    },
    "border": {
      "default": {
        "$value": "rgb(17 21 28 / 0.1)",
        "$type": "color"
      },
      "strong": {
        "$value": "rgb(17 21 28 / 0.24)",
        "$type": "color"
      }
    },
    "focus": {
      "$value": "{slate.900}",
      "$type": "color"
    },
    "accent": {
      "bg": {
        "$value": "{slate.900}",
        "$type": "color"
      },
      "bg-hover": {
        "$value": "{slate.700}",
        "$type": "color"
      },
      "fg": {
        "$value": "{slate.0}",
        "$type": "color"
      },
      "subtle": {
        "$value": "rgb(17 21 28 / 0.07)",
        "$type": "color"
      }
    },
    "danger": {
      "bg": {
        "$value": "{red.600}",
        "$type": "color"
      },
      "bg-hover": {
        "$value": "{red.700}",
        "$type": "color"
      },
      "fg": {
        "$value": "{slate.0}",
        "$type": "color"
      }
    },
    "tether": {
      "slack": {
        "$value": "rgb(17 21 28 / 0.2)",
        "$type": "color"
      },
      "taut": {
        "$value": "{slate.900}",
        "$type": "color"
      }
    },
    "sky": {
      "star": {
        "$value": "rgb(17 21 28 / 0)",
        "$type": "color"
      }
    },
    "status": {
      "running": {
        "fg": {
          "$value": "{slate.700}",
          "$type": "color"
        },
        "bg": {
          "$value": "rgb(17 21 28 / 0.06)",
          "$type": "color"
        }
      },
      "waiting": {
        "fg": {
          "$value": "{slate.0}",
          "$type": "color"
        },
        "bg": {
          "$value": "{slate.900}",
          "$type": "color"
        }
      },
      "blocked": {
        "fg": {
          "$value": "{slate.500}",
          "$type": "color"
        },
        "bg": {
          "$value": "rgb(17 21 28 / 0.04)",
          "$type": "color"
        }
      },
      "done": {
        "fg": {
          "$value": "{slate.500}",
          "$type": "color"
        },
        "bg": {
          "$value": "rgb(17 21 28 / 0.04)",
          "$type": "color"
        }
      },
      "failed": {
        "fg": {
          "$value": "{red.700}",
          "$type": "color"
        },
        "bg": {
          "$value": "color-mix(in srgb, {red.600} 9%, transparent)",
          "$type": "color"
        }
      }
    },
    "risk": {
      "low": {
        "fg": {
          "$value": "{slate.500}",
          "$type": "color"
        },
        "bg": {
          "$value": "rgb(17 21 28 / 0.04)",
          "$type": "color"
        }
      },
      "medium": {
        "fg": {
          "$value": "{slate.700}",
          "$type": "color"
        },
        "bg": {
          "$value": "rgb(17 21 28 / 0.06)",
          "$type": "color"
        }
      },
      "high": {
        "fg": {
          "$value": "{red.700}",
          "$type": "color"
        },
        "bg": {
          "$value": "color-mix(in srgb, {red.600} 9%, transparent)",
          "$type": "color"
        }
      }
    },
    "diff": {
      "added-bg": {
        "$value": "rgb(17 21 28 / 0.06)",
        "$type": "color"
      },
      "added-fg": {
        "$value": "{slate.700}",
        "$type": "color"
      },
      "removed-bg": {
        "$value": "color-mix(in srgb, {red.600} 8%, transparent)",
        "$type": "color"
      },
      "removed-fg": {
        "$value": "{red.600}",
        "$type": "color"
      }
    }
  },
  "shadow": {
    "sm": {
      "$value": "0 1px 2px rgb(11 14 19 / 0.06)"
    },
    "md": {
      "$value": "0 16px 40px rgb(11 14 19 / 0.1)"
    },
    "card": {
      "$value": "0 1px 2px rgb(11 14 19 / 0.04), 0 8px 24px rgb(11 14 19 / 0.05)"
    },
    "glow": {
      "$value": "0 16px 40px rgb(11 14 19 / 0.12)"
    }
  },
  "gradient": {
    "canvas": {
      "$value": "linear-gradient(180deg, #ffffff 0%, #f1f3f6 55%, #e6e9ee 100%)"
    },
    "horizon": {
      "$value": "radial-gradient(80% 50% at 50% 100%, rgb(11 14 19 / 0.05), transparent 70%)"
    }
  }
}