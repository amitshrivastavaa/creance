{
  "color": {
    "bg": {
      "canvas": {
        "$value": "{gray.50}",
        "$type": "color"
      },
      "surface": {
        "$value": "{gray.0}",
        "$type": "color"
      },
      "raised": {
        "$value": "{gray.0}",
        "$type": "color"
      },
      "subtle": {
        "$value": "rgb(120 120 128 / 0.12)",
        "$type": "color"
      },
      "inverse": {
        "$value": "{gray.900}",
        "$type": "color"
      },
      "overlay": {
        "$value": "rgb(0 0 0 / 0.2)",
        "$type": "color"
      }
    },
    "glass": {
      "surface": {
        "$value": "color-mix(in srgb, {color.bg.surface} {glass.opacity}, transparent)",
        "$type": "color"
      },
      "surface-strong": {
        "$value": "color-mix(in srgb, {color.bg.raised} {glass.opacity-strong}, transparent)",
        "$type": "color"
      },
      "highlight": {
        "$value": "rgb(255 255 255 / 0.75)",
        "$type": "color"
      },
      "control": {
        "$value": "color-mix(in srgb, {color.bg.surface} {glass.opacity-control}, transparent)",
        "$type": "color"
      },
      "clear": {
        "$value": "color-mix(in srgb, {color.bg.surface} {glass.opacity-clear}, transparent)",
        "$type": "color"
      }
    },
    "text": {
      "default": {
        "$value": "{gray.900}",
        "$type": "color"
      },
      "muted": {
        "$value": "{gray.500}",
        "$type": "color"
      },
      "inverse": {
        "$value": "{gray.0}",
        "$type": "color"
      },
      "link": {
        "$value": "{blue.700}",
        "$type": "color"
      }
    },
    "border": {
      "default": {
        "$value": "rgb(60 60 67 / 0.18)",
        "$type": "color"
      },
      "strong": {
        "$value": "rgb(60 60 67 / 0.4)",
        "$type": "color"
      }
    },
    "focus": {
      "$value": "{blue.600}",
      "$type": "color"
    },
    "accent": {
      "bg": {
        "$value": "{blue.600}",
        "$type": "color"
      },
      "bg-hover": {
        "$value": "{blue.700}",
        "$type": "color"
      },
      "fg": {
        "$value": "{gray.0}",
        "$type": "color"
      },
      "subtle": {
        "$value": "color-mix(in srgb, {blue.600} 12%, transparent)",
        "$type": "color"
      },
      "glass": {
        "$value": "color-mix(in srgb, {blue.650} {glass.opacity-tint}, transparent)",
        "$type": "color"
      }
    },
    "danger": {
      "bg": {
        "$value": "{red.600}",
        "$type": "color"
      },
      "bg-hover": {
        "$value": "{red.700}",
        "$type": "color"
      },
      "fg": {
        "$value": "{gray.0}",
        "$type": "color"
      },
      "glass": {
        "$value": "color-mix(in srgb, {red.600} {glass.opacity-tint}, transparent)",
        "$type": "color"
      }
    },
    "status": {
      "running": {
        "fg": {
          "$value": "{blue.700}",
          "$type": "color"
        },
        "bg": {
          "$value": "color-mix(in srgb, {blue.600} 13%, transparent)",
          "$type": "color"
        }
      },
      "waiting": {
        "fg": {
          "$value": "{violet.700}",
          "$type": "color"
        },
        "bg": {
          "$value": "color-mix(in srgb, {violet.600} 13%, transparent)",
          "$type": "color"
        }
      },
      "blocked": {
        "fg": {
          "$value": "{amber.700}",
          "$type": "color"
        },
        "bg": {
          "$value": "color-mix(in srgb, {amber.600} 13%, transparent)",
          "$type": "color"
        }
      },
      "done": {
        "fg": {
          "$value": "{green.700}",
          "$type": "color"
        },
        "bg": {
          "$value": "color-mix(in srgb, {green.600} 13%, transparent)",
          "$type": "color"
        }
      },
      "failed": {
        "fg": {
          "$value": "{red.700}",
          "$type": "color"
        },
        "bg": {
          "$value": "color-mix(in srgb, {red.600} 13%, transparent)",
          "$type": "color"
        }
      }
    },
    "risk": {
      "low": {
        "fg": {
          "$value": "{green.700}",
          "$type": "color"
        },
        "bg": {
          "$value": "color-mix(in srgb, {green.600} 13%, transparent)",
          "$type": "color"
        }
      },
      "medium": {
        "fg": {
          "$value": "{amber.700}",
          "$type": "color"
        },
        "bg": {
          "$value": "color-mix(in srgb, {amber.600} 13%, transparent)",
          "$type": "color"
        }
      },
      "high": {
        "fg": {
          "$value": "{red.700}",
          "$type": "color"
        },
        "bg": {
          "$value": "color-mix(in srgb, {red.600} 13%, transparent)",
          "$type": "color"
        }
      }
    },
    "diff": {
      "added-bg": {
        "$value": "color-mix(in srgb, {green.600} 14%, transparent)",
        "$type": "color"
      },
      "added-fg": {
        "$value": "{green.700}",
        "$type": "color"
      },
      "removed-bg": {
        "$value": "color-mix(in srgb, {red.600} 12%, transparent)",
        "$type": "color"
      },
      "removed-fg": {
        "$value": "{red.700}",
        "$type": "color"
      }
    }
  },
  "shadow": {
    "sm": {
      "$value": "0 1px 2px rgb(0 0 0 / 0.06)"
    },
    "md": {
      "$value": "0 12px 32px rgb(0 0 0 / 0.12), 0 2px 6px rgb(0 0 0 / 0.06)"
    },
    "glass": {
      "$value": "inset 1.5px 1.5px 1px -0.5px rgb(255 255 255 / 0.95), inset -1px -1px 1px -0.5px rgb(255 255 255 / 0.6), inset 0 0 14px rgb(255 255 255 / 0.35), 0 0 0 0.5px rgb(0 0 0 / 0.1), 0 2px 4px rgb(0 0 0 / 0.05), 0 10px 28px rgb(0 0 0 / 0.12)"
    },
    "card": {
      "$value": "0 1px 2px rgb(0 0 0 / 0.05), 0 4px 16px rgb(0 0 0 / 0.05)"
    },
    "text": {
      "$value": "0 1px 1.5px rgb(0 0 0 / 0.22)"
    }
  },
  "gradient": {
    "canvas": {
      "$value": "radial-gradient(70% 55% at 0% 0%, rgb(0 113 227 / 0.29), transparent 70%), radial-gradient(55% 50% at 100% 0%, rgb(191 90 242 / 0.26), transparent 70%), radial-gradient(70% 60% at 70% 100%, rgb(48 209 88 / 0.21), transparent 70%), radial-gradient(50% 50% at 0% 100%, rgb(255 159 10 / 0.16), transparent 70%)"
    },
    "sheen": {
      "$value": "linear-gradient(180deg, rgb(255 255 255 / 0.2), rgb(255 255 255 / 0) 60%)"
    },
    "agent": {
      "$value": "linear-gradient(135deg, {blue.500}, {violet.600})"
    },
    "glare": {
      "$value": "radial-gradient(120% 90% at 30% 0%, rgb(255 255 255 / 0.55), rgb(255 255 255 / 0) 50%)"
    }
  }
}