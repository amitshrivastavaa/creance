{
  "color": {
    "bg": {
      "canvas": {
        "$value": "{dawn.50}",
        "$type": "color"
      },
      "surface": {
        "$value": "{dawn.0}",
        "$type": "color"
      },
      "raised": {
        "$value": "{dawn.0}",
        "$type": "color"
      },
      "subtle": {
        "$value": "rgb(29 24 56 / 0.06)",
        "$type": "color"
      },
      "inverse": {
        "$value": "{ink.900}",
        "$type": "color"
      },
      "overlay": {
        "$value": "rgb(29 24 56 / 0.28)",
        "$type": "color"
      }
    },
    "glass": {
      "surface": {
        "$value": "color-mix(in srgb, {color.bg.surface} {glass.opacity}, transparent)",
        "$type": "color"
      }
    },
    "text": {
      "default": {
        "$value": "{ink.900}",
        "$type": "color"
      },
      "muted": {
        "$value": "{ink.500}",
        "$type": "color"
      },
      "inverse": {
        "$value": "{ink.50}",
        "$type": "color"
      },
      "link": {
        "$value": "{moon.700}",
        "$type": "color"
      }
    },
    "border": {
      "default": {
        "$value": "rgb(29 24 56 / 0.12)",
        "$type": "color"
      },
      "strong": {
        "$value": "rgb(29 24 56 / 0.28)",
        "$type": "color"
      }
    },
    "focus": {
      "$value": "{ember.600}",
      "$type": "color"
    },
    "accent": {
      "bg": {
        "$value": "{ember.600}",
        "$type": "color"
      },
      "bg-hover": {
        "$value": "{ember.700}",
        "$type": "color"
      },
      "fg": {
        "$value": "{dawn.0}",
        "$type": "color"
      },
      "subtle": {
        "$value": "color-mix(in srgb, {ember.600} 12%, transparent)",
        "$type": "color"
      }
    },
    "danger": {
      "bg": {
        "$value": "{coral.600}",
        "$type": "color"
      },
      "bg-hover": {
        "$value": "{coral.700}",
        "$type": "color"
      },
      "fg": {
        "$value": "{dawn.0}",
        "$type": "color"
      }
    },
    "tether": {
      "slack": {
        "$value": "rgb(29 24 56 / 0.25)",
        "$type": "color"
      },
      "taut": {
        "$value": "{ember.600}",
        "$type": "color"
      }
    },
    "status": {
      "running": {
        "fg": {
          "$value": "{moon.600}",
          "$type": "color"
        },
        "bg": {
          "$value": "color-mix(in srgb, {moon.600} 12%, transparent)",
          "$type": "color"
        }
      },
      "waiting": {
        "fg": {
          "$value": "{ember.700}",
          "$type": "color"
        },
        "bg": {
          "$value": "color-mix(in srgb, {ember.700} 12%, transparent)",
          "$type": "color"
        }
      },
      "blocked": {
        "fg": {
          "$value": "{lilac.600}",
          "$type": "color"
        },
        "bg": {
          "$value": "color-mix(in srgb, {lilac.600} 12%, transparent)",
          "$type": "color"
        }
      },
      "done": {
        "fg": {
          "$value": "{sage.700}",
          "$type": "color"
        },
        "bg": {
          "$value": "color-mix(in srgb, {sage.700} 12%, transparent)",
          "$type": "color"
        }
      },
      "failed": {
        "fg": {
          "$value": "{coral.700}",
          "$type": "color"
        },
        "bg": {
          "$value": "color-mix(in srgb, {coral.600} 12%, transparent)",
          "$type": "color"
        }
      }
    },
    "risk": {
      "low": {
        "fg": {
          "$value": "{sage.700}",
          "$type": "color"
        },
        "bg": {
          "$value": "color-mix(in srgb, {sage.700} 12%, transparent)",
          "$type": "color"
        }
      },
      "medium": {
        "fg": {
          "$value": "{ember.700}",
          "$type": "color"
        },
        "bg": {
          "$value": "color-mix(in srgb, {ember.700} 12%, transparent)",
          "$type": "color"
        }
      },
      "high": {
        "fg": {
          "$value": "{coral.600}",
          "$type": "color"
        },
        "bg": {
          "$value": "color-mix(in srgb, {coral.600} 12%, transparent)",
          "$type": "color"
        }
      }
    },
    "diff": {
      "added-bg": {
        "$value": "color-mix(in srgb, {sage.600} 13%, transparent)",
        "$type": "color"
      },
      "added-fg": {
        "$value": "{sage.700}",
        "$type": "color"
      },
      "removed-bg": {
        "$value": "color-mix(in srgb, {coral.600} 11%, transparent)",
        "$type": "color"
      },
      "removed-fg": {
        "$value": "{coral.700}",
        "$type": "color"
      }
    },
    "sky": {
      "star": {
        "$value": "rgb(29 24 56 / 0)",
        "$type": "color"
      }
    }
  },
  "shadow": {
    "sm": {
      "$value": "0 1px 2px rgb(29 24 56 / 0.08)"
    },
    "md": {
      "$value": "0 16px 40px rgb(29 24 56 / 0.16)"
    },
    "card": {
      "$value": "0 1px 2px rgb(29 24 56 / 0.06), 0 8px 24px rgb(29 24 56 / 0.06)"
    },
    "glow": {
      "$value": "0 0 0 1px rgb(180 83 15 / 0.35), 0 12px 40px rgb(180 83 15 / 0.18)"
    }
  },
  "gradient": {
    "canvas": {
      "$value": "linear-gradient(180deg, #dfe7ff 0%, #ece6f4 45%, #f3e7f0 75%, #ffe2cf 100%)"
    },
    "horizon": {
      "$value": "radial-gradient(80% 50% at 50% 100%, rgb(255 179 107 / 0.35), transparent 70%)"
    }
  }
}