{
  "color": {
    "bg": {
      "canvas": {
        "$value": "{gray.100}",
        "$type": "color"
      },
      "surface": {
        "$value": "{gray.0}",
        "$type": "color"
      },
      "raised": {
        "$value": "{gray.0}",
        "$type": "color"
      },
      "subtle": {
        "$value": "rgb(0 0 0 / 0.05)",
        "$type": "color"
      },
      "inverse": {
        "$value": "{gray.900}",
        "$type": "color"
      },
      "overlay": {
        "$value": "rgb(30 40 60 / 0.18)",
        "$type": "color"
      }
    },
    "glass": {
      "tint": {
        "$value": "{gray.0}",
        "$type": "color"
      },
      "window": {
        "$value": "color-mix(in srgb, {color.glass.tint} {glass.opacity.window}, transparent)",
        "$type": "color"
      },
      "tile": {
        "$value": "color-mix(in srgb, {color.glass.tint} {glass.opacity.tile}, transparent)",
        "$type": "color"
      },
      "sheet": {
        "$value": "color-mix(in srgb, {color.glass.tint} {glass.opacity.sheet}, transparent)",
        "$type": "color"
      },
      "popover": {
        "$value": "color-mix(in srgb, {color.glass.tint} {glass.opacity.popover}, transparent)",
        "$type": "color"
      },
      "control": {
        "$value": "color-mix(in srgb, {color.glass.tint} {glass.opacity.control}, transparent)",
        "$type": "color"
      },
      "surface": {
        "$value": "{color.glass.sheet}",
        "$type": "color"
      },
      "edge": {
        "$value": "rgb(255 255 255 / 0.7)",
        "$type": "color"
      },
      "highlight": {
        "$value": "rgb(255 255 255 / 0.85)",
        "$type": "color"
      }
    },
    "text": {
      "default": {
        "$value": "{gray.900}",
        "$type": "color"
      },
      "secondary": {
        "$value": "{gray.700}",
        "$type": "color"
      },
      "muted": {
        "$value": "{gray.500}",
        "$type": "color"
      },
      "inverse": {
        "$value": "{gray.0}",
        "$type": "color"
      },
      "link": {
        "$value": "#0066cc",
        "$type": "color"
      }
    },
    "border": {
      "default": {
        "$value": "rgb(0 0 0 / 0.1)",
        "$type": "color"
      },
      "strong": {
        "$value": "rgb(0 0 0 / 0.22)",
        "$type": "color"
      }
    },
    "focus": {
      "$value": "rgb(0 113 227 / 0.55)",
      "$type": "color"
    },
    "accent": {
      "bg": {
        "$value": "{blue.500}",
        "$type": "color"
      },
      "bg-hover": {
        "$value": "{blue.600}",
        "$type": "color"
      },
      "bg-active": {
        "$value": "{blue.700}",
        "$type": "color"
      },
      "fg": {
        "$value": "{gray.0}",
        "$type": "color"
      },
      "subtle": {
        "$value": "rgb(0 113 227 / 0.12)",
        "$type": "color"
      }
    },
    "ink": {
      "bg": {
        "$value": "{gray.900}",
        "$type": "color"
      },
      "bg-hover": {
        "$value": "{gray.700}",
        "$type": "color"
      },
      "fg": {
        "$value": "{gray.0}",
        "$type": "color"
      },
      "subtle": {
        "$value": "rgb(0 0 0 / 0.07)",
        "$type": "color"
      }
    },
    "danger": {
      "bg": {
        "$value": "{red.600}",
        "$type": "color"
      },
      "bg-hover": {
        "$value": "{red.700}",
        "$type": "color"
      },
      "fg": {
        "$value": "{gray.0}",
        "$type": "color"
      },
      "text": {
        "$value": "{red.600}",
        "$type": "color"
      }
    },
    "tether": {
      "slack": {
        "$value": "rgb(29 29 31 / 0.22)",
        "$type": "color"
      },
      "taut": {
        "$value": "{gray.900}",
        "$type": "color"
      }
    },
    "sky": {
      "star": {
        "$value": "rgb(29 29 31 / 0)",
        "$type": "color"
      }
    },
    "status": {
      "running": {
        "fg": {
          "$value": "{gray.700}",
          "$type": "color"
        },
        "bg": {
          "$value": "rgb(0 0 0 / 0.06)",
          "$type": "color"
        }
      },
      "waiting": {
        "fg": {
          "$value": "{gray.0}",
          "$type": "color"
        },
        "bg": {
          "$value": "{gray.900}",
          "$type": "color"
        }
      },
      "blocked": {
        "fg": {
          "$value": "{gray.500}",
          "$type": "color"
        },
        "bg": {
          "$value": "rgb(0 0 0 / 0.04)",
          "$type": "color"
        }
      },
      "done": {
        "fg": {
          "$value": "{gray.500}",
          "$type": "color"
        },
        "bg": {
          "$value": "rgb(0 0 0 / 0.04)",
          "$type": "color"
        }
      },
      "failed": {
        "fg": {
          "$value": "{red.700}",
          "$type": "color"
        },
        "bg": {
          "$value": "color-mix(in srgb, {red.600} 9%, transparent)",
          "$type": "color"
        }
      }
    },
    "risk": {
      "low": {
        "fg": {
          "$value": "{gray.500}",
          "$type": "color"
        },
        "bg": {
          "$value": "rgb(0 0 0 / 0.04)",
          "$type": "color"
        }
      },
      "medium": {
        "fg": {
          "$value": "{gray.700}",
          "$type": "color"
        },
        "bg": {
          "$value": "rgb(0 0 0 / 0.06)",
          "$type": "color"
        }
      },
      "high": {
        "fg": {
          "$value": "{red.700}",
          "$type": "color"
        },
        "bg": {
          "$value": "color-mix(in srgb, {red.600} 9%, transparent)",
          "$type": "color"
        }
      }
    },
    "diff": {
      "added-bg": {
        "$value": "rgb(0 0 0 / 0.06)",
        "$type": "color"
      },
      "added-fg": {
        "$value": "{gray.700}",
        "$type": "color"
      },
      "removed-bg": {
        "$value": "color-mix(in srgb, {red.600} 8%, transparent)",
        "$type": "color"
      },
      "removed-fg": {
        "$value": "{red.700}",
        "$type": "color"
      }
    }
  },
  "shadow": {
    "sm": {
      "$value": "0 1px 3px rgb(0 0 0 / 0.08)"
    },
    "card": {
      "$value": "0 2px 6px rgb(30 40 60 / 0.06)"
    },
    "md": {
      "$value": "0 30px 80px rgb(30 40 60 / 0.18), 0 2px 6px rgb(30 40 60 / 0.06)"
    },
    "sheet": {
      "$value": "0 20px 50px rgb(30 40 60 / 0.16)"
    },
    "glow": {
      "$value": "{shadow.sheet}"
    },
    "accent": {
      "$value": "0 6px 16px rgb(0 113 227 / 0.28)"
    }
  },
  "gradient": {
    "canvas": {
      "$value": "radial-gradient(60% 55% at 12% 18%, #c9d6ea, transparent 70%), radial-gradient(50% 55% at 88% 12%, #ddd3ea, transparent 70%), radial-gradient(70% 60% at 70% 95%, #cfdde6, transparent 70%)"
    },
    "horizon": {
      "$value": "radial-gradient(80% 50% at 50% 100%, rgb(30 40 60 / 0.05), transparent 70%)"
    }
  }
}