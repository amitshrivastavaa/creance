{
  "color": {
    "bg": {
      "canvas": {
        "$value": "{slate.950}",
        "$type": "color"
      },
      "surface": {
        "$value": "{slate.850}",
        "$type": "color"
      },
      "raised": {
        "$value": "{slate.800}",
        "$type": "color"
      },
      "subtle": {
        "$value": "rgb(255 255 255 / 0.07)",
        "$type": "color"
      },
      "inverse": {
        "$value": "{slate.50}",
        "$type": "color"
      },
      "overlay": {
        "$value": "rgb(0 0 0 / 0.6)",
        "$type": "color"
      }
    },
    "glass": {
      "surface": {
        "$value": "color-mix(in srgb, {color.bg.surface} {glass.opacity}, transparent)",
        "$type": "color"
      }
    },
    "text": {
      "default": {
        "$value": "{slate.50}",
        "$type": "color"
      },
      "muted": {
        "$value": "{slate.300}",
        "$type": "color"
      },
      "inverse": {
        "$value": "{slate.950}",
        "$type": "color"
      },
      "link": {
        "$value": "{slate.50}",
        "$type": "color"
      }
    },
    "border": {
      "default": {
        "$value": "rgb(255 255 255 / 0.11)",
        "$type": "color"
      },
      "strong": {
        "$value": "rgb(255 255 255 / 0.26)",
        "$type": "color"
      }
    },
    "focus": {
      "$value": "{slate.50}",
      "$type": "color"
    },
    "accent": {
      "bg": {
        "$value": "{slate.50}",
        "$type": "color"
      },
      "bg-hover": {
        "$value": "{slate.200}",
        "$type": "color"
      },
      "fg": {
        "$value": "{slate.950}",
        "$type": "color"
      },
      "subtle": {
        "$value": "rgb(255 255 255 / 0.1)",
        "$type": "color"
      }
    },
    "danger": {
      "bg": {
        "$value": "{red.400}",
        "$type": "color"
      },
      "bg-hover": {
        "$value": "{red.300}",
        "$type": "color"
      },
      "fg": {
        "$value": "{slate.950}",
        "$type": "color"
      }
    },
    "tether": {
      "slack": {
        "$value": "rgb(255 255 255 / 0.22)",
        "$type": "color"
      },
      "taut": {
        "$value": "{slate.50}",
        "$type": "color"
      }
    },
    "sky": {
      "star": {
        "$value": "rgb(255 255 255 / 0.5)",
        "$type": "color"
      }
    },
    "status": {
      "running": {
        "fg": {
          "$value": "{slate.200}",
          "$type": "color"
        },
        "bg": {
          "$value": "rgb(255 255 255 / 0.08)",
          "$type": "color"
        }
      },
      "waiting": {
        "fg": {
          "$value": "{slate.950}",
          "$type": "color"
        },
        "bg": {
          "$value": "{slate.50}",
          "$type": "color"
        }
      },
      "blocked": {
        "fg": {
          "$value": "{slate.300}",
          "$type": "color"
        },
        "bg": {
          "$value": "rgb(255 255 255 / 0.06)",
          "$type": "color"
        }
      },
      "done": {
        "fg": {
          "$value": "{slate.300}",
          "$type": "color"
        },
        "bg": {
          "$value": "rgb(255 255 255 / 0.06)",
          "$type": "color"
        }
      },
      "failed": {
        "fg": {
          "$value": "{red.400}",
          "$type": "color"
        },
        "bg": {
          "$value": "color-mix(in srgb, {red.400} 14%, transparent)",
          "$type": "color"
        }
      }
    },
    "risk": {
      "low": {
        "fg": {
          "$value": "{slate.300}",
          "$type": "color"
        },
        "bg": {
          "$value": "rgb(255 255 255 / 0.06)",
          "$type": "color"
        }
      },
      "medium": {
        "fg": {
          "$value": "{slate.200}",
          "$type": "color"
        },
        "bg": {
          "$value": "rgb(255 255 255 / 0.08)",
          "$type": "color"
        }
      },
      "high": {
        "fg": {
          "$value": "{red.400}",
          "$type": "color"
        },
        "bg": {
          "$value": "color-mix(in srgb, {red.400} 14%, transparent)",
          "$type": "color"
        }
      }
    },
    "diff": {
      "added-bg": {
        "$value": "rgb(255 255 255 / 0.08)",
        "$type": "color"
      },
      "added-fg": {
        "$value": "{slate.200}",
        "$type": "color"
      },
      "removed-bg": {
        "$value": "color-mix(in srgb, {red.400} 12%, transparent)",
        "$type": "color"
      },
      "removed-fg": {
        "$value": "{red.400}",
        "$type": "color"
      }
    }
  },
  "shadow": {
    "sm": {
      "$value": "0 1px 2px rgb(0 0 0 / 0.5)"
    },
    "md": {
      "$value": "0 16px 40px rgb(0 0 0 / 0.5)"
    },
    "card": {
      "$value": "0 1px 2px rgb(0 0 0 / 0.4), 0 8px 24px rgb(0 0 0 / 0.3)"
    },
    "glow": {
      "$value": "0 0 60px rgb(255 255 255 / 0.07)"
    }
  },
  "gradient": {
    "canvas": {
      "$value": "linear-gradient(180deg, #07090d 0%, #0e1218 50%, #1a2029 100%)"
    },
    "horizon": {
      "$value": "radial-gradient(80% 45% at 50% 100%, rgb(255 255 255 / 0.07), transparent 70%)"
    }
  }
}