{
  "color": {
    "bg": {
      "canvas": {
        "$value": "{gray.950}",
        "$type": "color"
      },
      "surface": {
        "$value": "{gray.900}",
        "$type": "color"
      },
      "raised": {
        "$value": "{gray.800}",
        "$type": "color"
      },
      "subtle": {
        "$value": "{gray.800}",
        "$type": "color"
      },
      "inverse": {
        "$value": "{gray.50}",
        "$type": "color"
      }
    },
    "text": {
      "default": {
        "$value": "{gray.50}",
        "$type": "color"
      },
      "muted": {
        "$value": "{gray.400}",
        "$type": "color"
      },
      "inverse": {
        "$value": "{gray.950}",
        "$type": "color"
      },
      "link": {
        "$value": "{blue.300}",
        "$type": "color"
      }
    },
    "border": {
      "default": {
        "$value": "{gray.700}",
        "$type": "color"
      },
      "strong": {
        "$value": "{gray.500}",
        "$type": "color"
      }
    },
    "focus": {
      "$value": "{blue.300}",
      "$type": "color"
    },
    "accent": {
      "bg": {
        "$value": "{blue.500}",
        "$type": "color"
      },
      "bg-hover": {
        "$value": "{blue.300}",
        "$type": "color"
      },
      "fg": {
        "$value": "{gray.950}",
        "$type": "color"
      },
      "subtle": {
        "$value": "{blue.900}",
        "$type": "color"
      }
    },
    "danger": {
      "bg": {
        "$value": "{red.600}",
        "$type": "color"
      },
      "bg-hover": {
        "$value": "{red.300}",
        "$type": "color"
      },
      "fg": {
        "$value": "{gray.0}",
        "$type": "color"
      }
    },
    "status": {
      "running": {
        "fg": {
          "$value": "{blue.300}",
          "$type": "color"
        },
        "bg": {
          "$value": "{blue.900}",
          "$type": "color"
        }
      },
      "waiting": {
        "fg": {
          "$value": "{violet.300}",
          "$type": "color"
        },
        "bg": {
          "$value": "{violet.900}",
          "$type": "color"
        }
      },
      "blocked": {
        "fg": {
          "$value": "{amber.300}",
          "$type": "color"
        },
        "bg": {
          "$value": "{amber.900}",
          "$type": "color"
        }
      },
      "done": {
        "fg": {
          "$value": "{green.300}",
          "$type": "color"
        },
        "bg": {
          "$value": "{green.900}",
          "$type": "color"
        }
      },
      "failed": {
        "fg": {
          "$value": "{red.300}",
          "$type": "color"
        },
        "bg": {
          "$value": "{red.900}",
          "$type": "color"
        }
      }
    },
    "risk": {
      "low": {
        "fg": {
          "$value": "{green.300}",
          "$type": "color"
        },
        "bg": {
          "$value": "{green.900}",
          "$type": "color"
        }
      },
      "medium": {
        "fg": {
          "$value": "{amber.300}",
          "$type": "color"
        },
        "bg": {
          "$value": "{amber.900}",
          "$type": "color"
        }
      },
      "high": {
        "fg": {
          "$value": "{red.300}",
          "$type": "color"
        },
        "bg": {
          "$value": "{red.900}",
          "$type": "color"
        }
      }
    },
    "diff": {
      "added-bg": {
        "$value": "{green.900}",
        "$type": "color"
      },
      "added-fg": {
        "$value": "{green.300}",
        "$type": "color"
      },
      "removed-bg": {
        "$value": "{red.900}",
        "$type": "color"
      },
      "removed-fg": {
        "$value": "{red.300}",
        "$type": "color"
      }
    }
  },
  "shadow": {
    "sm": {
      "$value": "0 1px 2px rgb(0 0 0 / 0.5)"
    },
    "md": {
      "$value": "0 4px 16px rgb(0 0 0 / 0.6)"
    }
  }
}