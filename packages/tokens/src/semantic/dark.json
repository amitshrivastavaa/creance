{
  "color": {
    "bg": {
      "canvas": {
        "$value": "{dusk.900}",
        "$type": "color"
      },
      "surface": {
        "$value": "{dusk.850}",
        "$type": "color"
      },
      "raised": {
        "$value": "{dusk.800}",
        "$type": "color"
      },
      "subtle": {
        "$value": "rgb(255 255 255 / 0.07)",
        "$type": "color"
      },
      "inverse": {
        "$value": "{ink.50}",
        "$type": "color"
      },
      "overlay": {
        "$value": "rgb(5 6 20 / 0.55)",
        "$type": "color"
      }
    },
    "glass": {
      "surface": {
        "$value": "color-mix(in srgb, {color.bg.surface} {glass.opacity}, transparent)",
        "$type": "color"
      }
    },
    "text": {
      "default": {
        "$value": "{ink.50}",
        "$type": "color"
      },
      "muted": {
        "$value": "{ink.300}",
        "$type": "color"
      },
      "inverse": {
        "$value": "{ink.900}",
        "$type": "color"
      },
      "link": {
        "$value": "{moon.300}",
        "$type": "color"
      }
    },
    "border": {
      "default": {
        "$value": "rgb(255 255 255 / 0.12)",
        "$type": "color"
      },
      "strong": {
        "$value": "rgb(255 255 255 / 0.26)",
        "$type": "color"
      }
    },
    "focus": {
      "$value": "{aurora.300}",
      "$type": "color"
    },
    "accent": {
      "bg": {
        "$value": "{aurora.400}",
        "$type": "color"
      },
      "bg-hover": {
        "$value": "{aurora.300}",
        "$type": "color"
      },
      "fg": {
        "$value": "{aurora.900}",
        "$type": "color"
      },
      "subtle": {
        "$value": "color-mix(in srgb, {aurora.400} 16%, transparent)",
        "$type": "color"
      }
    },
    "danger": {
      "bg": {
        "$value": "{coral.400}",
        "$type": "color"
      },
      "bg-hover": {
        "$value": "{coral.300}",
        "$type": "color"
      },
      "fg": {
        "$value": "{ink.900}",
        "$type": "color"
      }
    },
    "tether": {
      "slack": {
        "$value": "rgb(246 239 233 / 0.28)",
        "$type": "color"
      },
      "taut": {
        "$value": "{aurora.400}",
        "$type": "color"
      }
    },
    "status": {
      "running": {
        "fg": {
          "$value": "{moon.400}",
          "$type": "color"
        },
        "bg": {
          "$value": "color-mix(in srgb, {moon.400} 16%, transparent)",
          "$type": "color"
        }
      },
      "waiting": {
        "fg": {
          "$value": "{aurora.300}",
          "$type": "color"
        },
        "bg": {
          "$value": "color-mix(in srgb, {aurora.400} 16%, transparent)",
          "$type": "color"
        }
      },
      "blocked": {
        "fg": {
          "$value": "{lilac.400}",
          "$type": "color"
        },
        "bg": {
          "$value": "color-mix(in srgb, {lilac.400} 16%, transparent)",
          "$type": "color"
        }
      },
      "done": {
        "fg": {
          "$value": "{sage.400}",
          "$type": "color"
        },
        "bg": {
          "$value": "color-mix(in srgb, {sage.400} 16%, transparent)",
          "$type": "color"
        }
      },
      "failed": {
        "fg": {
          "$value": "{coral.300}",
          "$type": "color"
        },
        "bg": {
          "$value": "color-mix(in srgb, {coral.400} 16%, transparent)",
          "$type": "color"
        }
      }
    },
    "risk": {
      "low": {
        "fg": {
          "$value": "{sage.400}",
          "$type": "color"
        },
        "bg": {
          "$value": "color-mix(in srgb, {sage.400} 16%, transparent)",
          "$type": "color"
        }
      },
      "medium": {
        "fg": {
          "$value": "{lilac.300}",
          "$type": "color"
        },
        "bg": {
          "$value": "color-mix(in srgb, {lilac.400} 16%, transparent)",
          "$type": "color"
        }
      },
      "high": {
        "fg": {
          "$value": "{coral.400}",
          "$type": "color"
        },
        "bg": {
          "$value": "color-mix(in srgb, {coral.400} 16%, transparent)",
          "$type": "color"
        }
      }
    },
    "diff": {
      "added-bg": {
        "$value": "color-mix(in srgb, {sage.400} 14%, transparent)",
        "$type": "color"
      },
      "added-fg": {
        "$value": "{sage.300}",
        "$type": "color"
      },
      "removed-bg": {
        "$value": "color-mix(in srgb, {coral.400} 14%, transparent)",
        "$type": "color"
      },
      "removed-fg": {
        "$value": "{coral.300}",
        "$type": "color"
      }
    },
    "sky": {
      "star": {
        "$value": "rgb(255 255 255 / 0.55)",
        "$type": "color"
      }
    }
  },
  "shadow": {
    "sm": {
      "$value": "0 1px 2px rgb(0 0 0 / 0.4)"
    },
    "md": {
      "$value": "0 16px 40px rgb(0 0 0 / 0.45)"
    },
    "card": {
      "$value": "0 1px 2px rgb(0 0 0 / 0.3), 0 8px 24px rgb(0 0 0 / 0.25)"
    },
    "glow": {
      "$value": "0 0 0 1px rgb(111 220 242 / 0.45), 0 0 60px rgb(111 220 242 / 0.18)"
    }
  },
  "gradient": {
    "canvas": {
      "$value": "linear-gradient(180deg, #0b1530 0%, #1b1a42 40%, #2a2350 70%, #4a2f55 100%)"
    },
    "horizon": {
      "$value": "radial-gradient(80% 45% at 50% 100%, rgb(150 120 255 / 0.32), transparent 70%)"
    }
  }
}