{
  "color": {
    "bg": {
      "canvas": {
        "$value": "{gray.950}",
        "$type": "color"
      },
      "surface": {
        "$value": "{gray.900}",
        "$type": "color"
      },
      "raised": {
        "$value": "{gray.800}",
        "$type": "color"
      },
      "subtle": {
        "$value": "rgb(120 120 128 / 0.24)",
        "$type": "color"
      },
      "inverse": {
        "$value": "{gray.50}",
        "$type": "color"
      },
      "overlay": {
        "$value": "rgb(0 0 0 / 0.5)",
        "$type": "color"
      }
    },
    "glass": {
      "surface": {
        "$value": "color-mix(in srgb, {color.bg.surface} {glass.opacity}, transparent)",
        "$type": "color"
      },
      "surface-strong": {
        "$value": "color-mix(in srgb, {color.bg.raised} {glass.opacity-strong}, transparent)",
        "$type": "color"
      },
      "highlight": {
        "$value": "rgb(255 255 255 / 0.1)",
        "$type": "color"
      }
    },
    "text": {
      "default": {
        "$value": "{gray.50}",
        "$type": "color"
      },
      "muted": {
        "$value": "{gray.400}",
        "$type": "color"
      },
      "inverse": {
        "$value": "{gray.950}",
        "$type": "color"
      },
      "link": {
        "$value": "{blue.300}",
        "$type": "color"
      }
    },
    "border": {
      "default": {
        "$value": "rgb(235 235 245 / 0.14)",
        "$type": "color"
      },
      "strong": {
        "$value": "rgb(235 235 245 / 0.32)",
        "$type": "color"
      }
    },
    "focus": {
      "$value": "{blue.300}",
      "$type": "color"
    },
    "accent": {
      "bg": {
        "$value": "{blue.600}",
        "$type": "color"
      },
      "bg-hover": {
        "$value": "{blue.500}",
        "$type": "color"
      },
      "fg": {
        "$value": "{gray.0}",
        "$type": "color"
      },
      "subtle": {
        "$value": "color-mix(in srgb, {blue.500} 24%, transparent)",
        "$type": "color"
      }
    },
    "danger": {
      "bg": {
        "$value": "{red.600}",
        "$type": "color"
      },
      "bg-hover": {
        "$value": "{red.300}",
        "$type": "color"
      },
      "fg": {
        "$value": "{gray.0}",
        "$type": "color"
      }
    },
    "status": {
      "running": {
        "fg": {
          "$value": "{blue.300}",
          "$type": "color"
        },
        "bg": {
          "$value": "color-mix(in srgb, {blue.500} 22%, transparent)",
          "$type": "color"
        }
      },
      "waiting": {
        "fg": {
          "$value": "{violet.300}",
          "$type": "color"
        },
        "bg": {
          "$value": "color-mix(in srgb, {violet.600} 22%, transparent)",
          "$type": "color"
        }
      },
      "blocked": {
        "fg": {
          "$value": "{amber.300}",
          "$type": "color"
        },
        "bg": {
          "$value": "color-mix(in srgb, {amber.600} 22%, transparent)",
          "$type": "color"
        }
      },
      "done": {
        "fg": {
          "$value": "{green.300}",
          "$type": "color"
        },
        "bg": {
          "$value": "color-mix(in srgb, {green.600} 22%, transparent)",
          "$type": "color"
        }
      },
      "failed": {
        "fg": {
          "$value": "{red.300}",
          "$type": "color"
        },
        "bg": {
          "$value": "color-mix(in srgb, {red.600} 22%, transparent)",
          "$type": "color"
        }
      }
    },
    "risk": {
      "low": {
        "fg": {
          "$value": "{green.300}",
          "$type": "color"
        },
        "bg": {
          "$value": "color-mix(in srgb, {green.600} 22%, transparent)",
          "$type": "color"
        }
      },
      "medium": {
        "fg": {
          "$value": "{amber.300}",
          "$type": "color"
        },
        "bg": {
          "$value": "color-mix(in srgb, {amber.600} 22%, transparent)",
          "$type": "color"
        }
      },
      "high": {
        "fg": {
          "$value": "{red.300}",
          "$type": "color"
        },
        "bg": {
          "$value": "color-mix(in srgb, {red.600} 22%, transparent)",
          "$type": "color"
        }
      }
    },
    "diff": {
      "added-bg": {
        "$value": "color-mix(in srgb, {green.600} 26%, transparent)",
        "$type": "color"
      },
      "added-fg": {
        "$value": "{green.300}",
        "$type": "color"
      },
      "removed-bg": {
        "$value": "color-mix(in srgb, {red.600} 26%, transparent)",
        "$type": "color"
      },
      "removed-fg": {
        "$value": "{red.300}",
        "$type": "color"
      }
    }
  },
  "shadow": {
    "sm": {
      "$value": "0 1px 2px rgb(0 0 0 / 0.5)"
    },
    "md": {
      "$value": "0 12px 32px rgb(0 0 0 / 0.55), 0 2px 6px rgb(0 0 0 / 0.4)"
    },
    "glass": {
      "$value": "inset 0 1px 0 rgb(255 255 255 / 0.1), inset 0 0 0 1px rgb(255 255 255 / 0.04), 0 8px 28px rgb(0 0 0 / 0.45)"
    }
  },
  "gradient": {
    "canvas": {
      "$value": "radial-gradient(70% 55% at 0% 0%, rgb(10 132 255 / 0.33), transparent 70%), radial-gradient(55% 50% at 100% 0%, rgb(191 90 242 / 0.3), transparent 70%), radial-gradient(70% 60% at 70% 100%, rgb(48 209 88 / 0.18), transparent 70%), radial-gradient(50% 50% at 0% 100%, rgb(255 159 10 / 0.12), transparent 70%)"
    },
    "sheen": {
      "$value": "linear-gradient(180deg, rgb(255 255 255 / 0.2), rgb(255 255 255 / 0) 60%)"
    },
    "agent": {
      "$value": "linear-gradient(135deg, {blue.500}, {violet.600})"
    }
  }
}