{
  "name": "@creance-ui/tokens",
  "version": "0.2.0",
  "description": "Design tokens for Creance, as CSS custom properties (light and dark) and a typed JS export.",
  "license": "MIT",
  "author": "Amit Shrivastava",
  "homepage": "https://creance.pages.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amitshrivastavaa/creance.git",
    "directory": "packages/tokens"
  },
  "bugs": "https://github.com/amitshrivastavaa/creance/issues",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node build.mjs"
  },
  "devDependencies": {
    "style-dictionary": "^5.6.0"
  },
  "keywords": [
    "design-tokens",
    "css-variables",
    "style-dictionary",
    "design-system"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
