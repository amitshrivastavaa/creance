{
  "name": "creance-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/**' run build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . && node scripts/check-css-tokens.mjs && node scripts/check-use-client.mjs",
    "storybook": "pnpm --filter docs storybook",
    "build-storybook": "pnpm --filter docs build-storybook",
    "test": "pnpm -r test",
    "test:e2e": "playwright test --project=demo",
    "test:visual": "playwright test --project=visual",
    "test:visual:update": "sh scripts/visual-docker.sh --update-snapshots",
    "test:visual:docker": "sh scripts/visual-docker.sh",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish",
    "release:dry-run": "pnpm build && pnpm -r --filter './packages/**' publish --dry-run --no-git-checks",
    "test:next": "pnpm --filter next-app build && playwright test -c playwright.next.config.ts",
    "test:react18": "sh scripts/test-react18.sh",
    "site": "pnpm --filter site dev",
    "test:site": "pnpm --filter site build && playwright test -c playwright.site.config.ts",
    "test:ai-sdk": "pnpm --filter ai-sdk-example build && playwright test -c playwright.ai-sdk.config.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.64.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
