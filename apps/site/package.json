{
  "name": "site",
  "private": true,
  "type": "module",
  "scripts": {
    "props": "node scripts/extract-props.mjs",
    "dev": "pnpm props && vite",
    "build": "pnpm props && node scripts/build-registry.mjs && vite build && node scripts/build-llms.mjs",
    "test": "node --test scripts/*.test.mjs",
    "build:artifact": "pnpm props && vite build --config vite.artifact.config.ts && node scripts/build-artifact.mjs",
    "preview": "vite preview",
    "images": "node scripts/brand-images.mjs",
    "typecheck": "pnpm props && tsc --noEmit -p .",
    "thumbs": "node scripts/example-thumbs.mjs"
  },
  "dependencies": {
    "@creance-ui/react": "workspace:*",
    "@creance-ui/tokens": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "shadcn": "4.21.4",
    "typescript": "~6.0.3",
    "vite": "^8.3.3"
  }
}
